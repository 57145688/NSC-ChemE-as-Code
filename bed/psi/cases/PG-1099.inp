# PSI input generated for PG-1099, DN400, B31.1 screening.
app.units.set_user_units('si')
mdl = Model('PG-1099')
pipe = Pipe.from_file('pipe', '16', '40')
mat = Material.from_file('mat', 'A53A', 'B31.1')
Point(10)
run1 = Run(20, 12.691, 0, 0, section=pipe, material=mat)
run2 = Run(30, 0, 0, 5.439, section=pipe, material=mat)
Anchor('A1', 10).apply([run1, run2])
Z('G1', 30).apply([run1, run2])
Weight('W1', 1).apply([run1, run2])
Pressure('P1', 1, 165.00).apply([run1, run2])
Thermal('T1', 1, 557.65, 293.15).apply([run1, run2])
l1 = LoadCase('l1', 'sus', [Weight, Pressure], [1, 1])
l2 = LoadCase('l2', 'exp', [Thermal], [1])
B31167('B31.1').apply([run1, run2])
mdl.analyze()
Stresses('r1', [l1]).to_screen()
Stresses('r2', [l2]).to_screen()
